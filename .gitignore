# A copy of the project that ended up nested inside it. Not part of the source.
/perch/

# Icon set is generated from src/assets/mark.svg by `npm run icons`, but the
# results are committed: the Windows build needs icon.ico present, and CI has no
# reason to re-render it.
!src-tauri/icons/

# Local editor/tooling settings, not project source.
.claude/
.vscode/settings.json

# Machine-local cargo config: target dir and toolchain paths differ per machine,
# and a committed one breaks CI (an absolute Windows target-dir becomes a
# literal directory name on Linux). scripts/*.ps1 set CARGO_TARGET_DIR and put
# MinGW on PATH instead.
src-tauri/.cargo/
